datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  reports   Report[]
}

enum Role {
  USER
  ADMIN
}


model Report {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  lat         Float
  lng         Float
  category    String
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  /// where the problem is found cordinates on the map.
}
