datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  reports   Report[]
}

enum Role {
  USER
  ADMIN
}

model Institution {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  reports Report[]
}

model Report {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  lat         Float
  lng         Float
  category    String
  status      String    @default("Pending")
  institutionId Int?    
  institution   Institution? @relation(fields: [institutionId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
}
