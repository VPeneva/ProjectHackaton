     container_name: civicreport-proxy
     restart: unless-stopped
+    command: >
+      sh -c '
+      if [ -f /etc/nginx/ssl/cert.pem ] && [ -f /etc/nginx/ssl/key.pem ]; then
+        echo "SSL certificates found — enabling HTTPS on port 443";
+        cp /etc/nginx/ssl.conf.template /etc/nginx/conf.d/ssl.conf;
+      else
+        echo "No SSL certificates — running HTTP only";
+        rm -f /etc/nginx/conf.d/ssl.conf;
+      fi;
+      nginx -g "daemon off;"'
     ports:
       - "${PORT:-80}:80"
+      - "${SSL_PORT:-4443}:443"
     volumes:
       - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
+      - ./nginx/ssl.conf.template:/etc/nginx/ssl.conf.template:ro
+      - ./nginx/ssl:/etc/nginx/ssl:ro
     depends_on:
       - backend
       - frontend
